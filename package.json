{
  "name": "dsh-assistant-optimization",
  "version": "1.6.6",
  "description": "Fold mis-rendered thinking content into collapsible blocks, render mermaid inline, show file-edit diff counts, rewrite composer drafts with the current model, and resume interrupted turns from the send button.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qianshe/dsh-assistant-optimization.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "thinking",
    "reasoning",
    "mermaid",
    "prompt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
